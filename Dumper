--  AGNES FLASH COLLECT (Fixed)
-- ============================================
local AgnesFlashCollectConn = nil

local function toggleAgnesFlashCollect(enabled)
	if AgnesFlashCollectConn then
		AgnesFlashCollectConn:Disconnect()
		AgnesFlashCollectConn = nil
	end

	if not enabled then return end

	AgnesFlashCollectConn = Workspace.ChildAdded:Connect(function(child)
		if not CONFIG.AgnesFlashCollect then return end
		if not rootPart then return end

		local success = pcall(function()
			for _, part in ipairs(child:GetDescendants()) do
				if part:IsA("BasePart") and part.Transparency < 1 then
					local dist = (part.Position - rootPart.Position).Magnitude
					if dist < 30 then
						part.CFrame = rootPart.CFrame * CFrame.new(0, 1.5, 0)
					end
					break
				end
			end
		end)
	end)
end

-- ============================================
--  NOCLIP (Fixed)
-- ============================================
local noclipConn = nil

local function toggleNoclip(enabled)
	if noclipConn then
		noclipConn:Disconnect()
		noclipConn = nil
	end

	if not enabled then
		if not character then return end
		for _, p in ipairs(character:GetDescendants()) do
			if p:IsA("BasePart") then
				pcall(function() p.CanCollide = true end)
			end
		end
		return
	end

	noclipConn = RunService.Stepped:Connect(function()
		if not character then return end
		for _, p in ipairs(character:GetDescendants()) do
			if p:IsA("BasePart") then
				pcall(function() p.CanCollide = false end)
			end
		end
	end)
end

-- ============================================
--  ESP (Fixed & Enhanced)
-- ============================================
local espConn = nil
local espObjects = {}

local function toggleESP(enabled)
	if espConn then
		espConn:Disconnect()
		espConn = nil
	end

	-- Clear existing ESP
	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj.Name == "BZESP" or obj.Name == "BZESP_Billboard" then
			pcall(function() obj:Destroy() end)
		end
	end

	if not enabled then return end

	espConn = RunService.RenderStepped:Connect(function()
		for _, targetPlayer in ipairs(Players:GetPlayers()) do
			if targetPlayer ~= player then
				local targetChar = targetPlayer.Character
				if targetChar then
					local hrp = targetChar:FindFirstChild("HumanoidRootPart")
					local hum = targetChar:FindFirstChild("Humanoid")

					if hrp and hum and hum.Health > 0 then
						-- Selection Box
						if not hrp:FindFirstChild("BZESP") then
							local box = Instance.new("SelectionBox")
							box.Name = "BZESP"
							box.LineThickness = 0.03
							box.Color = Color3.fromRGB(255, 0, 128)
							box.Adornee = hrp
							box.Parent = hrp
						end

						-- Name Tag
						if not hrp:FindFirstChild("BZESP_Billboard") then
							local billboard = Instance.new("BillboardGui")
							billboard.Name = "BZESP_Billboard"
							billboard.Size = UDim2.new(0, 100, 0, 40)
							billboard.StudsOffset = Vector3.new(0, 3, 0)
							billboard.AlwaysOnTop = true
							billboard.Parent = hrp

							local nameLabel = Instance.new("TextLabel")
							nameLabel.Size = UDim2.new(1, 0, 0.5, 0)
							nameLabel.BackgroundTransparency = 1
							nameLabel.Text = targetPlayer.Name
							nameLabel.TextColor3 = Color3.fromRGB(255, 0, 128)
							nameLabel.TextSize = 14
							nameLabel.Font = Enum.Font.GothamBold
							nameLabel.Parent = billboard

							local hpLabel = Instance.new("TextLabel")
							hpLabel.Size = UDim2.new(1, 0, 0.5, 0)
							hpLabel.Position = UDim2.new(0, 0, 0.5, 0)
							hpLabel.BackgroundTransparency = 1
							hpLabel.Text = math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)
							hpLabel.TextColor3 = Color3.fromRGB(0, 255, 150)
							hpLabel.TextSize = 12
							hpLabel.Font = Enum.Font.Gotham
							hpLabel.Parent = billboard
						end

						-- Update HP
						local billboard = hrp:FindFirstChild("BZESP_Billboard")
						if billboard then
							local hpLabel = billboard:FindFirstChildOfClass("TextLabel")
							if hpLabel and hpLabel.Position.Y.Scale > 0 then
								hpLabel.Text = math.floor(hum.Health) .. "/" .. math.floor(hum.MaxHealth)
							end
						end
					end
				end
			end
		end
	end)
end

