-- ██████  SECTION: REMOTE SPY  ██████
-- ============================================================
local Spy = {
    Enabled = false,
    Logs = {},
    MaxLogs = 2000,
    FilterMode = "Blacklist",   -- "Blacklist" | "Whitelist"
    Filters = {},                -- {[remoteName/path] = true}
    WatchList = {},              -- {[remoteName] = true} → real-time print
    OnCall = nil,                -- function(entry) end
    _hooked = false,
    _originalNamecall = nil,
}
ReplicatedStorageDumper.RemoteSpy = Spy

-- --- Filter ---
function Spy:AddFilter(remoteName)
    self.Filters[remoteName] = true
end

function Spy:RemoveFilter(remoteName)
    self.Filters[remoteName] = nil
end

function Spy:ClearFilters()
    self.Filters = {}
end

function Spy:_shouldLog(remote)
    local name = remote.Name
    local path
    local ok, _path = pcall(function() return remote:GetFullName() end)
    path = ok and _path or name

    if self.FilterMode == "Whitelist" then
        return self.Filters[name] == true or self.Filters[path] == true
    else -- Blacklist
        return self.Filters[name] ~= true and self.Filters[path] ~= true
    end
end

-- --- Watch (real-time print) ---
function Spy:Watch(remoteName)
    self.WatchList[remoteName] = true
end

function Spy:Unwatch(remoteName)
    self.WatchList[remoteName] = nil
end

-- --- Serialize Args ---
local function serializeArgs(args)
    local out = {}
    for i, arg in ipairs(args) do
        local ok, val = pcall(serializeValue, arg)
        out[i] = ok and val or { _type = "error", value = tostring(arg) }
    end
    return out
end

-- --- Log ---
function Spy:Log(remote, method, args, direction)
    if not self:_shouldLog(remote) then return end

    local ok, path = pcall(function() return remote:GetFullName() end)
    local entry = {
        id = #self.Logs + 1,
        timestamp = os.clock(),
        time = os.date("%H:%M:%S"),
        remote = remote.Name,
        path = ok and path or remote.Name,
        className = remote.ClassName,
        method = method,
        direction = direction,
        argsCount = #args,
        args = serializeArgs(args),
    }

    table.insert(self.Logs, entry)
    if #self.Logs > self.MaxLogs then
        table.remove(self.Logs, 1)
    end

    -- Real-time watch
    if self.WatchList[remote.Name] then
        print(string.format(
            "🔍 [Spy] %s → %s (%s) | Args[%d]: %s",
            entry.time, remote.Name, direction, #args,
            HttpService:JSONEncode(entry.args):sub(1, 200)
        ))
    end

    -- Callback
    if self.OnCall then
        pcall(self.OnCall, entry)
    end

    return entry
end

-- --- Clear / Search / Stats ---
function Spy:ClearLogs()
    self.Logs = {}
end

function Spy:SearchLogs(query)
    query = query:lower()
    local results = {}
    for _, entry in ipairs(self.Logs) do
        if entry.remote:lower():find(query, 1, true) or entry.path:lower():find(query, 1, true) then
            table.insert(results, entry)
        end
    end
    return results
end

function Spy:SearchByArg(query)
    query = tostring(query):lower()
    local results = {}
    for _, entry in ipairs(self.Logs) do
        local ok, json = pcall(function() return HttpService:JSONEncode(entry.args):lower() end)
        if ok and json:find(query, 1, true) then
            table.insert(results, entry)
        end
    end
    return results
end

function Spy:GetStats()
    local stats = {
        totalCalls = #self.Logs,
        byRemote = {},
        byMethod = {},
        byDirection = {},
        byClass = {},
    }
    for _, e in ipairs(self.Logs) do
        stats.byRemote[e.remote] = (stats.byRemote[e.remote] or 0) + 1
        stats.byMethod[e.method] = (stats.byMethod[e.method] or 0) + 1
        stats.byDirection[e.direction] = (stats.byDirection[e.direction] or 0) + 1
        stats.byClass[e.className] = (stats.byClass[e.className] or 0) + 1
    end
    return stats
end

function Spy:GetTopRemotes(n)
    n = n or 10
    local stats = self:GetStats()
    local sorted = {}
    for name, count in pairs(stats.byRemote) do
        table.insert(sorted, { name = name, count = count })
    end
    table.sort(sorted, function(a, b) return a.count > b.count end)
    local out = {}
    for i = 1, math.min(n, #sorted) do out[i] = sorted[i] end
    return out
end

function Spy:ExportLogs()
    return ReplicatedStorageDumper.toJSON({
        exportTime = os.date("%Y-%m-%d %H:%M:%S"),
        totalLogs = #self.Logs,
        logs = self.Logs,
    }, true)
end

-- --- Start / Stop ---
function Spy:Start()
    if not _isExploitEnv then
        warn("[RemoteSpy] ⚠️ ตองใช Exploit Environment (hookmetamethod / getnamecallmethod)")
        return false
    end
    if self._hooked then
        self.Enabled = true
        return true
    end

    self.Enabled = true
    self._hooked = true

    self._originalNamecall = _hookmetamethod(game, "__namecall", _newcclosure(function(self, ...)
        local method = _getnamecallmethod()

        -- ตรวจว่าเปน Remote หรือไม
        local remoteType = nil
        local direction = nil

        if method == "FireServer" then
            if self:IsA("RemoteEvent") then remoteType = "RemoteEvent"; direction = "Client→Server"
            elseif self:IsA("UnreliableRemoteEvent") then remoteType = "UnreliableRemoteEvent"; direction = "Client→Server"
            end
        elseif method == "InvokeServer" and self:IsA("RemoteFunction") then
            remoteType = "RemoteFunction"; direction = "Client→Server"
        elseif method == "FireClient" and self:IsA("RemoteEvent") then
            remoteType = "RemoteEvent"; direction = "Server→Client"
        elseif method == "FireAllClients" and self:IsA("RemoteEvent") then
            remoteType = "RemoteEvent"; direction = "Server→AllClients"
        elseif method == "InvokeClient" and self:IsA("RemoteFunction") then
            remoteType = "RemoteFunction"; direction = "Server→Client"
        end

        if direction and Spy.Enabled then
            local args = { ... }
            local Hook = ReplicatedStorageDumper.RemoteHook

            -- ดึง hook ของ remote ตัวนี
            local remoteName = self.Name
            local hookData = Hook.Hooks[remoteName] or Hook.Hooks[self:GetFullName()]

            -- ตรวจบล็อค
            if Hook.BlockedRemotes[remoteName] or Hook.BlockedRemotes[self:GetFullName()] then
                Spy:Log(self, method, args, direction .. " [BLOCKED]")
                if remoteType == "RemoteFunction" then return nil end
                return
            end

            -- แกไข args ผาน onCall
            if hookData and hookData.onCall then
                local ok, modArgs = pcall(hookData.onCall, self, method, args)
                if ok and modArgs ~= nil then
                    args = modArgs
                end
            end

            -- บันทึก log
            Spy:Log(self, method, args, direction)

            -- เรียก original
            if remoteType == "RemoteFunction" then
                local returnVals = { self:InvokeServer(unpack(args)) }
                -- แกไข return ผาน onReturn
                if hookData and hookData.onReturn then
                    local ok, modReturn = pcall(hookData.onReturn, self, method, unpack(returnVals))
                    if ok and modReturn ~= nil then
                        return modReturn
                    end
                end
                return unpack(returnVals)
            else
                return self[method](self, unpack(args))
            end
        end

        return Spy._originalNamecall(self, ...)
    end))

    print("[RemoteSpy] ✅ เริมดักฟัง Remotes แลว (hookmetamethod __namecall)")
    return true
end

function Spy:Stop()
    self.Enabled = false
    print("[RemoteSpy] ⏹️ หยุดดักฟัง (Enabled = false)")
end

