-- █████████████████████████████████████████████████████████████
-- ███  FULL SCAN  ███
-- █████████████████████████████████████████████████████████████
function Dumper.FullScan(config)
    config = config or Dumper.Config

    print("\n╔══════════════════════════════════════════════╗")
    print("║   🚀 FULL SCAN — " .. executorName .. " " .. executorVersion)
    print("╚══════════════════════════════════════════════╝")

    -- 1. Structure dump
    local structure = Dumper.dumpReplicatedStorage(config)
    print(string.format("  📦 Structure: %d instances", structure._dumpInfo.totalInstances))

    -- 2. Dump remotes
    local report = Dump:DumpAll(nil, config)
    local s = report.summary
    print(string.format("  📡 Remotes: %d (Event:%d  Function:%d  Unreliable:%d)",
        s.totalRemotes, s.remoteEvents, s.remoteFunctions, s.unreliableRemoteEvents))

    -- 3. Deep scan (nil + GC)
    local deepCount = 0
    if hasNilInst or hasGetGC then
        local deep = Dump:DeepScan()
        deepCount = #deep
        print(string.format("  🔍 DeepScan: %d unique remotes (incl. nil + GC)", deepCount))
    end

    -- 4. Print tree
    Dump:PrintTree()

    -- 5. Start spy
    if hasHookAPI then
        Spy:Start()
        print("  🔍 RemoteSpy: ✅ ACTIVE")
    else
        print("  🔍 RemoteSpy: ❌ No hook API")
    end

    -- 6. Watch
    Dump:WatchForNewRemotes()
    print("  👀 Auto-Watch: ACTIVE")

    -- 7. Drawing UI
    if hasDrawing then
        Dumper.CreateSpyUI()
        print("  🖥️  Drawing UI: ✅")
    end

    -- 8. API summary
    print("\n  📋 API Status:")
    print(string.format("    hookmetamethod: %s", hasHookAPI and "✅" or "❌"))
    print(string.format("    writefile:     %s", hasFileAPI and "✅" or "❌"))
    print(string.format("    getnilinstances: %s", hasNilInst and "✅" or "❌"))
    print(string.format("    getgc:         %s", hasGetGC and "✅" or "❌"))
    print(string.format("    Drawing:       %s", hasDrawing and "✅" or "❌"))
    print(string.format("    cloneref:      %s", hasCloneref and "✅" or "❌"))

    print("\n✅ Full Scan Complete!\n")

    return {
        structure  = structure,
        remotes    = report,
        deepCount  = deepCount,
        spyActive  = Spy.Enabled,
        watching   = true,
        uiActive   = Dumper._uiEnabled,
    }
end

