--[[
    ReplicatedStorage Dumper v2.0
    - ดึง/Backup ทุกอย่างใน ReplicatedStorage หรือ Service ใดก็ได้
    - Remote Spy: ดักฟังทุก Remote Call (Client/Server)
    - Remote Hook: แก้ไข Args / บล็อค / ดัดแปลง Return
    - Dump All Remotes: สแกนหาทุก Remote ในเกม + Auto-Watch
    วางใน ReplicatedStorage
]]

local ReplicatedStorageDumper = {}
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

-- ============================================================
-- ตรวจสอบ Exploit API
-- ============================================================
local _hookmetamethod = hookmetamethod
local _getnamecallmethod = getnamecallmethod
local _newcclosure = newcclosure or function(f) return f end
local _hookfunction = hookfunction
local _isExploitEnv = (_hookmetamethod ~= nil) and (_getnamecallmethod ~= nil)

