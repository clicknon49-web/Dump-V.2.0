-- ██████  SECTION: DUMP ALL REMOTES  ██████
-- ============================================================
local Dump = {
    DefaultServices = {
        "ReplicatedStorage",
        "Workspace",
        "StarterGui",
        "StarterPack",
        "StarterPlayerScripts",
        "StarterCharacterScripts",
        "Lighting",
    },
    _watchConnections = {},
}
ReplicatedStorageDumper.RemoteDump = Dump

function Dump:FindRemotesInService(serviceName)
    local ok, service = pcall(function() return game:GetService(serviceName) end)
    if not ok then return {} end

    local remotes = {}
    for _, inst in ipairs(service:GetDescendants()) do
        if inst:IsA("RemoteEvent") or inst:IsA("RemoteFunction") or inst:IsA("UnreliableRemoteEvent") then
            table.insert(remotes, inst)
        end
    end
    return remotes
end

function Dump:FindAllRemotes(services)
    services = services or self.DefaultServices
    local all = {}
    for _, svcName in ipairs(services) do
        local remotes = self:FindRemotesInService(svcName)
        for _, r in ipairs(remotes) do table.insert(all, r) end
    end
    return all
end

function Dump:DumpAll(services, config)
    services = services or self.DefaultServices
    config = config or ReplicatedStorageDumper.Config

    local report = {
        timestamp = os.time(),
        date = os.date("%Y-%m-%d %H:%M:%S"),
        services = {},
        summary = {
            totalRemotes = 0,
            remoteEvents = 0,
            remoteFunctions = 0,
            unreliableRemoteEvents = 0,
        },
        remotes = {},
    }

    for _, svcName in ipairs(services) do
        local remotes = self:FindRemotesInService(svcName)
        local svcData = { name = svcName, count = #remotes, remotes = {} }

        for _, remote in ipairs(remotes) do
            local ok, path = pcall(function() return remote:GetFullName() end)
            local rData = {
                name = remote.Name,
                className = remote.ClassName,
                path = ok and path or remote.Name,
                parent = remote.Parent and remote.Parent.Name or "?",
            }

            if config.SaveAttributes then
                local attrs = remote:GetAttributes()
                if next(attrs) then rData.attributes = attrs end
            end

            local children = remote:GetChildren()
            if #children > 0 then
                rData.children = {}
                for _, ch in ipairs(children) do
                    table.insert(rData.children, { name = ch.Name, className = ch.ClassName })
                end
            end

            table.insert(svcData.remotes, rData)
            table.insert(report.remotes, rData)

            report.summary.totalRemotes = report.summary.totalRemotes + 1
            if remote.ClassName == "RemoteEvent" then
                report.summary.remoteEvents = report.summary.remoteEvents + 1
            elseif remote.ClassName == "RemoteFunction" then
                report.summary.remoteFunctions = report.summary.remoteFunctions + 1
            elseif remote.ClassName == "UnreliableRemoteEvent" then
                report.summary.unreliableRemoteEvents = report.summary.unreliableRemoteEvents + 1
            end
        end

        table.insert(report.services, svcData)
    end

    table.sort(report.remotes, function(a, b) return a.name:lower() < b.name:lower() end)
    return report
end

function Dump:DumpAllJSON(services, config)
    local report = self:DumpAll(services, config)
    return ReplicatedStorageDumper.toJSON(report, true)
end

function Dump:SaveDump(services, config)
    local report = self:DumpAll(services, config)
    return ReplicatedStorageDumper.saveToFile(report, "RemoteDump_" .. os.time())
end

-- --- Group by Parent ---
function Dump:GroupByParent(services)
    local remotes = self:FindAllRemotes(services)
    local groups = {}

    for _, remote in ipairs(remotes) do
        local parent = remote.Parent
        local key = parent and parent:GetFullName() or "Unknown"
        if not groups[key] then
            groups[key] = { parentName = parent and parent.Name or "?", parentPath = key, remotes = {} }
        end
        table.insert(groups[key].remotes, { name = remote.Name, className = remote.ClassName })
    end
    return groups
end

-- --- Tree View ---
function Dump:PrintTree(services)
    local remotes = self:FindAllRemotes(services)
    local tree = {}

    for _, remote in ipairs(remotes) do
        local ok, path = pcall(function() return remote:GetFullName() end)
        local fullPath = ok and path or remote.Name
        local parts = fullPath:split(".")
        local current = tree

        for i, part in ipairs(parts) do
            if i == #parts then
                -- leaf
                local icon = remote:IsA("RemoteEvent") and "📡"
                    or remote:IsA("RemoteFunction") and "📞"
                    or "📶"
                table.insert(current, { type = "remote", icon = icon, name = part, className = remote.ClassName })
            else
                -- folder
                local found = nil
                for _, node in ipairs(current) do
                    if node.type == "folder" and node.name == part then found = node break end
                end
                if not found then
                    found = { type = "folder", name = part, children = {} }
                    table.insert(current, found)
                end
                current = found.children
            end
        end
    end

    local function printNode(node, indent)
        indent = indent or ""
        if node.type == "folder" then
            print(indent .. "📁 " .. node.name .. "/")
            for _, child in ipairs(node.children) do
                printNode(child, indent .. "  ")
            end
        else
            print(indent .. node.icon .. " " .. node.name .. "  [" .. node.className .. "]")
        end
    end

    print("\n========== REMOTE TREE ==========")
    for _, node in ipairs(tree) do
        printNode(node)
    end
    print("=================================\n")
end

-- --- Watch for New Remotes ---
function Dump:WatchForNewRemotes(callback, services)
    services = services or self.DefaultServices

    for _, conn in ipairs(self._watchConnections) do
        conn:Disconnect()
    end
    self._watchConnections = {}

    for _, svcName in ipairs(services) do
        local ok, service = pcall(function() return game:GetService(svcName) end)
        if ok then
            local conn = service.DescendantAdded:Connect(function(desc)
                if desc:IsA("RemoteEvent") or desc:IsA("RemoteFunction") or desc:IsA("UnreliableRemoteEvent") then
                    local info = {
                        name = desc.Name,
                        className = desc.ClassName,
                        path = desc:GetFullName(),
                        service = svcName,
                        timestamp = os.clock(),
                        time = os.date("%H:%M:%S"),
                    }
                    print(string.format("[RemoteDump] 🆕 New: %s (%s) → %s", desc.Name, desc.ClassName, info.path))
                    if callback then pcall(callback, info) end
                end
            end)
            table.insert(self._watchConnections, conn)
        end
    end

    print(string.format("[RemoteDump] 👀 Watching %d services for new remotes", #services))
    return self._watchConnections
end

function Dump:StopWatching()
    for _, conn in ipairs(self._watchConnections) do
        conn:Disconnect()
    end
    self._watchConnections = {}
    print("[RemoteDump] ⏹️ Stopped watching")
end

