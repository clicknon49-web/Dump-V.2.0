-- ██████  FULL SCAN (รวมทุกอย่าง)  ██████
-- ============================================================
function ReplicatedStorageDumper.FullScan(config)
    config = config or ReplicatedStorageDumper.Config

    print("\n╔══════════════════════════════════════════╗")
    print("║     🚀  FULL SCAN — ReplicatedStorage     ║")
    print("╚══════════════════════════════════════════╝")

    -- 1. Dump Structure
    local structure = ReplicatedStorageDumper.dumpReplicatedStorage(config)
    print(string.format("  📦 Structure: %d instances", structure._dumpInfo.totalInstances))

    -- 2. Dump All Remotes
    local remoteReport = Dump:DumpAll(nil, config)
    local s = remoteReport.summary
    print(string.format("  📡 Remotes: %d total (Event:%d  Function:%d  Unreliable:%d)",
        s.totalRemotes, s.remoteEvents, s.remoteFunctions, s.unreliableRemoteEvents))

    -- 3. Print Remote Tree
    Dump:PrintTree()

    -- 4. Start Remote Spy (ถ้า Exploit Env)
    if _isExploitEnv then
        Spy:Start()
        print("  🔍 RemoteSpy: ACTIVE")
    else
        print("  🔍 RemoteSpy: ⚠️ No Exploit API")
    end

    -- 5. Watch for new remotes
    Dump:WatchForNewRemotes()
    print("  👀 Auto-Watch: ACTIVE")

    print("\n✅ Full Scan Complete!\n")

    return {
        structure = structure,
        remotes = remoteReport,
        spyActive = Spy.Enabled,
        watching = true,
    }
end

return ReplicatedStorageDumper
