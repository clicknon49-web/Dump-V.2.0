-- ██████  SECTION: REMOTE HOOK  ██████
-- ============================================================
local Hook = {
    Hooks = {},            -- {[remoteName/path] = { onCall, onReturn, block }}
    BlockedRemotes = {},   -- {[remoteName/path] = true}
}
ReplicatedStorageDumper.RemoteHook = Hook

function Hook:HookRemote(remoteName, options)
    -- options: { onCall = fn(remote, method, args)→args, onReturn = fn(remote, method, ret)→ret, block = bool }
    self.Hooks[remoteName] = options
    if options.block then
        self.BlockedRemotes[remoteName] = true
    end
    print(string.format("[RemoteHook] 🪝  Hook: %s | onCall:%s onReturn:%s block:%s",
        remoteName,
        options.onCall and "✅" or "❌",
        options.onReturn and "✅" or "❌",
        options.block and "🚫" or "✅"
    ))
end

function Hook:Unhook(remoteName)
    self.Hooks[remoteName] = nil
    self.BlockedRemotes[remoteName] = nil
    print(string.format("[RemoteHook] ❌ Unhook: %s", remoteName))
end

function Hook:Block(remoteName)
    self.BlockedRemotes[remoteName] = true
    print(string.format("[RemoteHook] 🚫  Block: %s", remoteName))
end

function Hook:Unblock(remoteName)
    self.BlockedRemotes[remoteName] = nil
    print(string.format("[RemoteHook] ✅ Unblock: %s", remoteName))
end

function Hook:ToggleBlock(remoteName)
    if self.BlockedRemotes[remoteName] then
        self:Unblock(remoteName)
    else
        self:Block(remoteName)
    end
end

function Hook:BlockAll()
    local remotes = ReplicatedStorageDumper.RemoteDump:FindAllRemotes()
    for _, r in ipairs(remotes) do
        self.BlockedRemotes[r.Name] = true
    end
    print(string.format("[RemoteHook] 🚫  Block All: %d remotes", #remotes))
end

function Hook:UnblockAll()
    self.BlockedRemotes = {}
    print("[RemoteHook] ✅ Unblock All")
end

function Hook:ListHooks()
    local result = {}
    for name, h in pairs(self.Hooks) do
        table.insert(result, {
            remote = name,
            hasOnCall = h.onCall ~= nil,
            hasOnReturn = h.onReturn ~= nil,
            blocked = self.BlockedRemotes[name] == true,
        })
    end
    return result
end

function Hook:ListBlocked()
    local list = {}
    for name, blocked in pairs(self.BlockedRemotes) do
        if blocked then table.insert(list, name) end
    end
    table.sort(list)
    return list
end

