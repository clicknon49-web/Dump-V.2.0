local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local mouse = player:GetMouse()

-- Wait for character
local character
repeat
    character = player.Character
    task.wait(0.1)
until character

local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

-- ============================================
--  CONFIG — กดปุ่มลัดได้
-- ============================================
local CONFIG = {
    Enabled = false,
    MaxDupes = 20,
    DupeSpeed = 0.1,
    WalkSpeed = 50,
    JumpPower = 100,
    Agnes 2.5 FlashCollect = true,
    Noclip = false,
    ESP = false,
}

-- Apply stats
humanoid.WalkSpeed = CONFIG.WalkSpeed
humanoid.JumpPower = CONFIG.JumpPower

-- ============================================
--  NOTIFICATION SYSTEM (แทน UI)
-- ============================================
local function notify(msg, color)
    color = color or Color3.fromRGB(255, 255, 255)
    
    -- สร้าง notification บนจอ
    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, 350, 0, 45)
    notif.Position = UDim2.new(0.5, -175, 0, 80)
    notif.BackgroundColor3 = Color3.fromRGB(15, 15, 25)
    notif.BorderSizePixel = 0
    notif.Parent = player:WaitForChild("PlayerGui")
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = notif
    
    local border = Instance.new("UIStroke")
    border.Color = color
    border.Thickness = 2
    border.Parent = notif
    
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(1, 0, 1, 0)
    label.BackgroundTransparency = 1
    label.Text = "🍆 " .. msg
    label.TextColor3 = color
    label.TextSize = 14
    label.Font = Enum.Font.GothamBold
    label.Parent = notif
    
    -- Fade in
    notif.BackgroundTransparency = 1
    local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Quad)
    game:GetService("TweenService"):Create(notif, tweenInfo, {BackgroundTransparency = 0}):Play()
    
    -- Fade out & destroy after 3s
    task.delay(3, function()
        game:GetService("TweenService"):Create(notif, tweenInfo, {BackgroundTransparency = 1}):Play()
        task.wait(0.3)
        notif:Destroy()
    end)
end

-- ============================================
--  DUPE SYSTEM
-- ============================================
local dupeParts = {}
local dupeConn = nil

local function getTool()
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") then return child end
    end
    return nil
end

local function createDupe()
    local tool = getTool()
    if not tool then
        notify("ไม่มี Tool ในมือ! จับ pickaxe ก่อน", Color3.fromRGB(255, 100, 100))
        return
    end
    
    notify("เริ่ม Dupe! กด Tool เพื่อสร้าง", Color3.fromRGB(0, 255, 150))
    
    dupeConn = tool.Activated:Connect(function()
        if not CONFIG.Enabled then return end
        
        local originalCFrame = rootPart.CFrame
        local count = 0
        
        for i = 1, CONFIG.MaxDupes do
            if not CONFIG.Enabled then break end
            
            local dupe = character:Clone()
            dupe.Name = "Dupe_" .. i
            dupe.Parent = workspace
            
            -- Offset สุ่ม
            local offset = CFrame.new(
                math.random(-2, 2),
                math.random(0, 1),
                math.random(-2, 2)
            )
            
            local hrp = dupe:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = originalCFrame * offset
            end
            
            -- Disable humanoid
            local h = dupe:FindFirstChild("Humanoid")
            if h then
                h.WalkSpeed = 0
                h.JumpPower = 0
            end
            
            table.insert(dupeParts, dupe)
            count = count + 1
            
            task.wait(CONFIG.DupeSpeed)
        end
        
        notify("สร้าง Dupe: " .. count .. " ตัว", Color3.fromRGB(0, 200, 255))
    end)
    
    notify("Dupe Active — กด Tool เพื่อสร้าง!", Color3.fromRGB(0, 255, 150))
end

local function clearDupes()
    if dupeConn then
        dupeConn:Disconnect()
        dupeConn = nil
    end
    
    for _, dupe in ipairs(dupeParts) do
        if dupe and dupe.Parent then
            dupe:Destroy()
        end
    end
    dupeParts = {}
    
    notify("ล้าง Dupe ทั้งหมดแล้ว", Color3.fromRGB(255, 100, 100))
end

-- ============================================
--  Agnes 2.5 Flash COLLECT
-- ============================================
local Agnes 2.5 FlashCollectConn = nil

local function startAgnes 2.5 FlashCollect()
    if Agnes 2.5 FlashCollectConn then Agnes 2.5 FlashCollectConn:Disconnect() end
    
    Agnes 2.5 FlashCollectConn = workspace.ChildAdded:Connect(function(child)
        if not CONFIG.Agnes 2.5 FlashCollect then return end
        
        local hrp = rootPart
        if not hrp then return end
        
        -- Check if collectible
        local isCollectible = false
        for _, part in ipairs(child:GetDescendants()) do
            if part:IsA("BasePart") and part.Transparency < 1 then
                local dist = (part.Position - hrp.Position).Magnitude
                if dist < 25 then
                    part.CFrame = hrp.CFrame * CFrame.new(0, 1.5, 0)
                    isCollectible = true
                    break
                end
            end
        end
    end)
end

-- ============================================
--  NOCLIP
-- ============================================
local noclipConn = nil

local function setNoclip(enabled)
    if noclipConn then
        noclipConn:Disconnect()
        noclipConn = nil
    end
    
    if not enabled then
        -- Restore collision
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
        return
    end
    
    noclipConn = RunService.Stepped:Connect(function()
        if not CONFIG.Noclip then return end
        for _, part in ipairs(character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)
end

-- ============================================
--  ESP
-- ============================================
local espConn = nil

local function toggleESP()
    if espConn then
        espConn:Disconnect()
        espConn = nil
    end
    
    -- Remove existing
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "BluezyESP_Box" then obj:Destroy() end
    end
    
    if not CONFIG.ESP then return end
    
    espConn = RunService.RenderStepped:Connect(function()
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj:IsA("Model") and obj ~= character then
                local hrp = obj:FindFirstChild("HumanoidRootPart")
                local hum = obj:FindFirstChild("Humanoid")
                
                if hrp and hum and hum.Health > 0 then
                    if not obj:FindFirstChild("BluezyESP_Box") then
                        local box = Instance.new("SelectionBox")
                        box.Name = "BluezyESP_Box"
                        box.LineThickness = 2
                        box.Color = Color3.fromRGB(255, 0, 128)
                        box.Adornee = hrp
                        box.Parent = hrp
                    end
                end
            end
        end
    end)
end

-- ============================================
--  KEY BINDS — กดปุ่มลัด
-- ============================================
local keyBinds = {
    [Enum.KeyCode.F] = function()
        CONFIG.Enabled = not CONFIG.Enabled
        if CONFIG.Enabled then
            createDupe()
            notify("Dupe: ON (กด F ปิด)", Color3.fromRGB(0, 255, 150))
        else
            clearDupes()
            notify("Dupe: OFF", Color3.fromRGB(255, 100, 100))
        end
    end,
    
    [Enum.KeyCode.G] = function()
        clearDupes()
        notify("ล้าง Dupe ทั้งหมด (G)", Color3.fromRGB(255, 150, 0))
    end,
    
    [Enum.KeyCode.H] = function()
        CONFIG.Agnes 2.5 FlashCollect = not CONFIG.Agnes 2.5 FlashCollect
        if CONFIG.Agnes 2.5 FlashCollect then
            startAgnes 2.5 FlashCollect()
            notify("Agnes 2.5 Flash Collect: ON (กด H ปิด)", Color3.fromRGB(0, 200, 255))
        else
            notify("Agnes 2.5 Flash Collect: OFF", Color3.fromRGB(150, 150, 150))
        end
    end,
    
    [Enum.KeyCode.J] = function()
        CONFIG.Noclip = not CONFIG.Noclip
        setNoclip(CONFIG.Noclip)
        notify("Noclip: " .. tostring(CONFIG.Noclip) .. " (กด J)", Color3.fromRGB(200, 200, 200))
    end,
    
    [Enum.KeyCode.K] = function()
        CONFIG.ESP = not CONFIG.ESP
        toggleESP()
        notify("ESP: " .. tostring(CONFIG.ESP) .. " (กด K)", Color3.fromRGB(255, 0, 128))
    end,
    
    [Enum.KeyCode.L] = function()
        for _, p in ipairs(Players:GetPlayers()) do
            if p ~= player then
                local c = p.Character
                if c then
                    c:Destroy()
                end
            end
        end
        notify("Kill All — Done!", Color3.fromRGB(255, 50, 50))
    end,
    
    [Enum.KeyCode.Semicolon] = function()
        -- ; = Teleport to mouse
        local target = mouse.Target
        if target then
            rootPart.CFrame = CFrame.new(mouse.Hit.Position + Vector3.new(0, 3, 0))
            notify("Teleport!", Color3.fromRGB(100, 255, 100))
        end
    end,
}

UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if keyBinds[input.KeyCode] then
        keyBinds[input.KeyCode]()
    end
end)

