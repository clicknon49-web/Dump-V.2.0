local function serializeValue(value)
    local t = typeof(value)
    if t == "Instance" then
        local ok, name = pcall(function() return value:GetFullName() end)
        return { _type = "Instance", value = ok and name or "?" }
    elseif t == "Color3" then
        return { _type = "Color3", R = math.round(value.R * 255), G = math.round(value.G * 255), B = math.round(value.B * 255) }
    elseif t == "Vector3" then
        return { _type = "Vector3", X = value.X, Y = value.Y, Z = value.Z }
    elseif t == "CFrame" then
        return { _type = "CFrame", comps = { value:GetComponents() } }
    elseif t == "EnumItem" then
        return { _type = "Enum", value = tostring(value) }
    elseif t == "BrickColor" then
        return { _type = "BrickColor", value = tostring(value) }
    elseif t == "table" then
        local ok, j = pcall(function() return HttpService:JSONEncode(value) end)
        if ok then return value end
        return { _type = "table", value = "unserializable" }
    else
        return value
    end
end

local function getProperties(instance, config)
    local cn = instance.ClassName
    local props = CLASS_PROPERTIES[cn] or {"Name", "ClassName"}
    local data = { Name = instance.Name, ClassName = cn }
    for _, pn in ipairs(props) do
        local ok, val = pcall(function() return instance[pn] end)
        if ok then data[pn] = serializeValue(val) end
    end
    if config.SaveAttributes then
        local attrs = instance:GetAttributes()
        if next(attrs) then data._attributes = attrs end
    end
    return data
end

----------------------------------------------------------------
-- ███ CORE DUMP
----------------------------------------------------------------
function Dumper.dumpInstance(instance, config, depth)
    config = config or Dumper.Config
    depth = depth or 0
    if depth > config.MaxDepth then
        return { Name = instance.Name, ClassName = instance.ClassName, _truncated = true }
    end
    local data = getProperties(instance, config)
    local children = instance:GetChildren()
    if #children > 0 then
        data._children = {}
        for _, child in ipairs(children) do
            if not config.IncludeRobloxLocked then
                local ok, locked = pcall(function() return child.RobloxLocked end)
                if ok and locked then continue end
            end
            table.insert(data._children, Dumper.dumpInstance(child, config, depth + 1))
        end
    end
    return data
end

function Dumper.toJSON(data, pretty)
    local ok, result = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok then
        result = safeJSONEncode(data)
    end
    if pretty ~= false then
        result = result:gsub("},", "},\n"):gsub("%],", "%],\n")
    end
    return result
end

function Dumper.saveToFile(data, filename)
    filename = filename or ("Dump_" .. os.time())
    local json = Dumper.toJSON(data, false)
    if not json then return false end

    -- Delta: writefile
    if hasFileAPI then
        local folder = Dumper.Config.DumpFolder or "DumperDumps"
        if not _isfolder(folder) then
            pcall(_makefolder, folder)
        end
        local path = folder .. "/" .. filename .. ".json"
        local ok, err = pcall(_writefile, path, json)
        if ok then
            print(string.format("[Dumper] ✅ Saved to disk: %s (%d chars)", path, #json))
            return path
        else
            warn("[Dumper] writefile failed: " .. tostring(err))
        end
    end

    -- Fallback: Studio → ServerStorage
    if RunService:IsStudio() then
        local folder = game.ServerStorage:FindFirstChild("StorageDumps")
        if not folder then
            folder = Instance.new("Folder")
            folder.Name = "StorageDumps"
            folder.Parent = game.ServerStorage
        end
        local mod = Instance.new("ModuleScript")
        mod.Name = filename
        mod.Source = "-- Dump\n-- " .. os.date("%Y-%m-%d %H:%M:%S") .. "\nreturn [[" .. json .. "]]"
        mod.Parent = folder
        print(string.format("[Dumper] ✅ Saved: ServerStorage.StorageDumps.%s", filename))
        return true
    end

    -- Fallback: return JSON string
    print("[Dumper] ⚠️ No file API — JSON length: " .. #json)
    return json
end

function Dumper.readFile(path)
    if hasFileAPI then
        local ok, content = pcall(_readfile, path)
        if ok then return content end
    end
    return nil
end

function Dumper.dumpReplicatedStorage(config)
