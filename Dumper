-- ============================================
--  DUPE SYSTEM
-- ============================================
local dupeParts = {}
local dupeConn = nil

local function getTool()
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") then return child end
    end
    return nil
end

local function startDupe()
    local tool = getTool()
    if not tool then
        notify("ไม่มี Tool! จับ pickaxe ก่อน", Color3.fromRGB(255, 80, 80))
        return false
    end
    
    if dupeConn then dupeConn:Disconnect() end
    
    dupeConn = tool.Activated:Connect(function()
        if not CONFIG.DupeEnabled then return end
        
        local origin = rootPart.CFrame
        local count = 0
        
        for i = 1, CONFIG.DupeCount do
            if not CONFIG.DupeEnabled then break end
            
            local dupe = character:Clone()
            dupe.Name = "Dupe_" .. i
            dupe.Parent = workspace
            
            local hrp = dupe:FindFirstChild("HumanoidRootPart")
            if hrp then
                hrp.CFrame = origin * CFrame.new(
                    math.random(-3, 3),
                    math.random(0, 2),
                    math.random(-3, 3)
                )
            end
            
            local h = dupe:FindFirstChild("Humanoid")
            if h then
                h.WalkSpeed = 0
                h.JumpPower = 0
            end
            
            table.insert(dupeParts, dupe)
            count = count + 1
            task.wait(CONFIG.DupeSpeed)
        end
        
        notify("สร้าง Dupe: " .. count .. " ตัว", Color3.fromRGB(0, 255, 200))
    end)
    
    notify("Dupe Mode: ON — กด Tool เพื่อสร้าง!", Color3.fromRGB(0, 255, 150))
    return true
end

local function clearDupes()
    if dupeConn then
        dupeConn:Disconnect()
        dupeConn = nil
    end
    for _, d in ipairs(dupeParts) do
        if d and d.Parent then d:Destroy() end
    end
    dupeParts = {}
    notify("ล้าง Dupe ทั้งหมด", Color3.fromRGB(255, 100, 100))
end

-- ============================================
--  Agnes 2.5 Flash COLLECT
-- ============================================
local Agnes 2.5 FlashCollectConn = nil

local function toggleAgnes 2.5 FlashCollect(enabled)
    if Agnes 2.5 FlashCollectConn then
        Agnes 2.5 FlashCollectConn:Disconnect()
        Agnes 2.5 FlashCollectConn = nil
    end
    
    if not enabled then return end
    
    Agnes 2.5 FlashCollectConn = workspace.ChildAdded:Connect(function(child)
        if not CONFIG.Agnes 2.5 FlashCollect then return end
        local hrp = rootPart
        if not hrp then return end
        
        for _, part in ipairs(child:GetDescendants()) do
            if part:IsA("BasePart") and part.Transparency < 1 then
                local dist = (part.Position - hrp.Position).Magnitude
                if dist < 30 then
                    part.CFrame = hrp.CFrame * CFrame.new(0, 1.5, 0)
                end
                break
            end
        end
    end)
end

-- ============================================
--  NOCLIP
-- ============================================
local noclipConn = nil

local function toggleNoclip(enabled)
    if noclipConn then
        noclipConn:Disconnect()
        noclipConn = nil
    end
    
    if not enabled then
        for _, p in ipairs(character:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = true end
        end
        return
    end
    
    noclipConn = RunService.Stepped:Connect(function()
        for _, p in ipairs(character:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end)
end

-- ============================================
--  ESP
-- ============================================
local espConn = nil

local function toggleESP(enabled)
    if espConn then
        espConn:Disconnect()
        espConn = nil
    end
    
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj.Name == "BZESP" then obj:Destroy() end
    end
    
    if not enabled then return end
    
    espConn = RunService.RenderStepped:Connect(function()
        for _, obj in ipairs(workspace:GetChildren()) do
            if obj:IsA("Model") and obj ~= character then
                local hrp = obj:FindFirstChild("HumanoidRootPart")
                local hum = obj:FindFirstChild("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    if not hrp:FindFirstChild("BZESP") then
                        local box = Instance.new("SelectionBox")
                        box.Name = "BZESP"
                        box.LineThickness = 2
                        box.Color = Color3.fromRGB(255, 0, 128)
                        box.Adornee = hrp
                        box.Parent = hrp
                    end
                end
            end
        end
    end)
end

