local function safeRef(obj)
    if _cloneref then
        local ok, ref = pcall(_cloneref, obj)
        return ok and ref or obj
    end
    return obj
end

----------------------------------------------------------------
-- ███ SAFE JSON (Delta บอย circular ref / overflow)
----------------------------------------------------------------
local function safeJSONEncode(data, maxDepth)
    maxDepth = maxDepth or 20
    local function serialize(val, depth, seen)
        if depth > maxDepth then return "..." end
        local t = type(val)
        if t == "nil" then return "null"
        elseif t == "boolean" then return val and "true" or "false"
        elseif t == "number" then
            if val ~= val then return "null" end  -- NaN
            if math.abs(val) == math.huge then return "null" end
            return tostring(val)
        elseif t == "string" then
            return '"' .. val:gsub('\\', '\\\\'):gsub('"', '\\"'):gsub('\n', '\\n'):gsub('\t', '\\t') .. '"'
        elseif t == "table" then
            if seen[val] then return '"[circular]"' end
            seen[val] = true
            if next(val) == nil then seen[val] = nil; return "{}" end
            -- Check if array-like
            local isArray = true
            local count = 0
            for k in pairs(val) do
                count = count + 1
                if type(k) ~= "number" or k ~= count then isArray = false; break end
            end
            if isArray and count > 0 then
                local parts = {}
                for i = 1, count do
                    parts[i] = serialize(val[i], depth + 1, seen)
                end
                seen[val] = nil
                return "[" .. table.concat(parts, ",") .. "]"
            else
                local parts = {}
                for k, v in pairs(val) do
                    parts[#parts + 1] = serialize(tostring(k), depth + 1, seen) .. ":" .. serialize(v, depth + 1, seen)
                end
                seen[val] = nil
                return "{" .. table.concat(parts, ",") .. "}"
            end
        else
            return '"' .. tostring(val):gsub('"', '\\"') .. '"'
        end
    end
    return serialize(data, 0, {})
end

