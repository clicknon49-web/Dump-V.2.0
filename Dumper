-- ███  DRAWING UI (Delta)  ███
-- █████████████████████████████████████████████████████████████
Dumper._uiEnabled  = false
Dumper._uiObjects  = {}
Dumper._updateUI   = nil

function Dumper.CreateSpyUI(toggleKey)
    if not hasDrawing then
        warn("[UI] Drawing API ไม่พร้อมใช้งานบน executor นี้")
        return false
    end

    toggleKey = toggleKey or Enum.KeyCode.RightShift

    -- ทำลาย UI เดิม
    Dumper.DestroySpyUI()

    local UI = {}
    Dumper._uiObjects = UI

    local W, H = 420, 260
    local X, Y = 10, 10
    local visible = true
    local recentLogs = {}
    local maxVisible = 8

    -- Background
    UI.bg = _Drawing.new("Square")
    UI.bg.Size = _Drawing.new("Vector2", W, H)
    UI.bg.Position = _Drawing.new("Vector2", X, Y)
    UI.bg.Filled = true
    UI.bg.Color = _Drawing.new("Color3", 0.08, 0.08, 0.12)
    UI.bg.Transparency = 0.1
    UI.bg.Visible = true
    UI.bg.ZIndex = 1

    -- Border
    UI.border = _Drawing.new("Square")
    UI.border.Size = _Drawing.new("Vector2", W, H)
    UI.border.Position = _Drawing.new("Vector2", X, Y)
    UI.border.Filled = false
    UI.border.Thickness = 1
    UI.border.Color = _Drawing.new("Color3", 0.2, 0.6, 1)
    UI.border.Visible = true
    UI.border.ZIndex = 2

    -- Title
    UI.title = _Drawing.new("Text")
    UI.title.Text = "🔍 Remote Spy — " .. executorName
    UI.title.Size = 14
    UI.title.Font = 2
    UI.title.Color = _Drawing.new("Color3", 0.2, 0.6, 1)
    UI.title.Position = _Drawing.new("Vector2", X + 8, Y + 4)
    UI.title.Visible = true
    UI.title.ZIndex = 3

    -- Separator
    UI.sep = _Drawing.new("Square")
    UI.sep.Size = _Drawing.new("Vector2", W - 4, 1)
    UI.sep.Position = _Drawing.new("Vector2", X + 2, Y + 22)
    UI.sep.Filled = true
    UI.sep.Color = _Drawing.new("Color3", 0.2, 0.3, 0.5)
    UI.sep.Visible = true
    UI.sep.ZIndex = 2

    -- Log lines
    UI.lines = {}
    for i = 1, maxVisible do
        local line = _Drawing.new("Text")
        line.Text = ""
        line.Size = 12
        line.Font = 2
        line.Color = _Drawing.new("Color3", 1, 1, 1)
        line.Position = _Drawing.new("Vector2", X + 6, Y + 26 + (i - 1) * 28)
        line.Visible = true
        line.ZIndex = 3

        local lineBg = _Drawing.new("Square")
        lineBg.Size = _Drawing.new("Vector2", W - 8, 26)
        lineBg.Position = _Drawing.new("Vector2", X + 4, Y + 25 + (i - 1) * 28)
        lineBg.Filled = true
        lineBg.Transparency = 0.8
        lineBg.Color = _Drawing.new("Color3", 0.15, 0.15, 0.2)
        lineBg.Visible = true
        lineBg.ZIndex = 2

        UI.lines[i] = { text = line, bg = lineBg }
    end

    -- Status bar
    UI.status = _Drawing.new("Text")
    UI.status.Text = "Logs: 0 | Press [" .. tostring(toggleKey):gsub("Enum.KeyCode.", "") .. "] to toggle"
    UI.status.Size = 11
    UI.status.Font = 2
    UI.status.Color = _Drawing.new("Color3", 0.5, 0.5, 0.5)
    UI.status.Position = _Drawing.new("Vector2", X + 8, Y + H - 18)
    UI.status.Visible = true
    UI.status.ZIndex = 3

    -- สีตาม direction
    local dirColors = {
        ["Client→Server"]     = { r = 1, g = 0.3, b = 0.3 },
        ["Server→Client"]     = { r = 0.3, g = 1,   b = 0.3 },
        ["Server→AllClients"] = { r = 0.3, g = 0.7, b = 1   },
    }

    -- update function
    Dumper._updateUI = function(entry)
        recentLogs[#recentLogs + 1] = entry
        if #recentLogs > maxVisible then
            table.remove(recentLogs, 1)
        end

        for i, line in ipairs(UI.lines) do
            local log = recentLogs[i]
            if log then
                local dc = dirColors[log.direction:gsub(" %[BLOCKED%]", "")] or { r = 1, g = 1, b = 1 }
                local icon = log.className == "RemoteFunction" and "📞" or "📡"
                local txt = string.format("%s %s %s | %s", icon, log.time, log.remote, log.direction)
                if #log.preview > 0 then
                    txt = txt .. " | " .. log.preview:sub(1, 40)
                end
                line.text.Text = txt
                line.text.Color = _Drawing.new("Color3", dc.r, dc.g, dc.b)
                if log.direction:find("BLOCKED") then
                    line.bg.Color = _Drawing.new("Color3", 0.3, 0.1, 0.1)
                else
                    line.bg.Color = _Drawing.new("Color3", 0.15, 0.15, 0.2)
                end
            else
                line.text.Text = ""
            end
        end

        UI.status.Text = "Logs: " .. #Spy.Logs .. " | Press [" ..
            tostring(toggleKey):gsub("Enum.KeyCode.", "") .. "] to toggle"
    end

    -- Keybind toggle
    local uiConn
    uiConn = game:GetService("UserInputService").InputBegan:Connect(function(input, gp)
        if gp then return end
        if input.KeyCode == toggleKey then
            visible = not visible
            for _, obj in pairs(UI) do
                if type(obj) == "table" and obj.Visible ~= nil then
                    obj.Visible = visible
                end
            end
            -- lines
            for _, line in ipairs(UI.lines) do
                line.text.Visible = visible
                line.bg.Visible = visible
            end
            UI.bg.Visible = visible
            UI.border.Visible = visible
            UI.title.Visible = visible
            UI.sep.Visible = visible
            UI.status.Visible = visible
        end
    end)

    Dumper._uiEnabled = true
    Dumper._uiConn = uiConn

    print(string.format("[UI] ✅ Drawing UI created | Toggle: [%s]", tostring(toggleKey):gsub("Enum.KeyCode.", "")))
    return true
end

function Dumper.DestroySpyUI()
    Dumper._uiEnabled = false
    Dumper._updateUI = nil

    if Dumper._uiConn then
        pcall(function() Dumper._uiConn:Disconnect() end)
        Dumper._uiConn = nil
    end

    for _, obj in pairs(Dumper._uiObjects) do
        if type(obj) == "table" then
            if obj.Destroy then pcall(obj.Destroy, obj) end
            -- lines sub-table
            if obj.text then pcall(obj.text.Destroy, obj.text) end
            if obj.bg then pcall(obj.bg.Destroy, obj.bg) end
        end
    end
    Dumper._uiObjects = {}
    print("[UI] 🗑️ Drawing UI destroyed")
end

