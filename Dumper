-- ============================================================
-- Helper: ทำ serialize ค่าต่างๆ
-- ============================================================
local function serializeValue(value)
    local t = typeof(value)
    if t == "Instance" then
        local ok, name = pcall(function() return value:GetFullName() end)
        return { _type = "Instance", value = ok and name or "?" }
    elseif t == "Color3" then
        return { _type = "Color3", R = value.R, G = value.G, B = value.B }
    elseif t == "Vector3" then
        return { _type = "Vector3", X = value.X, Y = value.Y, Z = value.Z }
    elseif t == "CFrame" then
        return { _type = "CFrame", components = { value:GetComponents() } }
    elseif t == "EnumItem" then
        return { _type = "Enum", value = tostring(value) }
    elseif t == "BrickColor" then
        return { _type = "BrickColor", value = tostring(value) }
    elseif t == "table" then
        local ok, json = pcall(function() return HttpService:JSONEncode(value) end)
        if ok then return value end
        return { _type = "table", value = "unserializable" }
    else
        return value
    end
end

local function getProperties(instance, config)
    local className = instance.ClassName
    local props = CLASS_PROPERTIES[className] or {"Name", "ClassName"}
    local data = { Name = instance.Name, ClassName = className }

    for _, propName in ipairs(props) do
        local success, value = pcall(function() return instance[propName] end)
        if success then
            data[propName] = serializeValue(value)
        end
    end

    if config.SaveAttributes then
        local attrs = instance:GetAttributes()
        if next(attrs) then data._attributes = attrs end
    end

    return data
end

-- ============================================================
-- SECTION: dumpInstance / toJSON / saveToFile (เดม)
-- ============================================================
function ReplicatedStorageDumper.dumpInstance(instance, config, depth)
    config = config or ReplicatedStorageDumper.Config
    depth = depth or 0
    if depth > config.MaxDepth then
        return { Name = instance.Name, ClassName = instance.ClassName, _truncated = true }
    end

    local data = getProperties(instance, config)
    local children = instance:GetChildren()
    if #children > 0 then
        data._children = {}
        for _, child in ipairs(children) do
            if not config.IncludeRobloxLocked then
                local ok, locked = pcall(function() return child.RobloxLocked end)
                if ok and locked then continue end
            end
            table.insert(data._children, ReplicatedStorageDumper.dumpInstance(child, config, depth + 1))
        end
    end
    return data
end

function ReplicatedStorageDumper.toJSON(data, pretty)
    pretty = pretty ~= false
    local success, result = pcall(function() return HttpService:JSONEncode(data) end)
    if success then
        if pretty then
            result = result:gsub("},", "},\n"):gsub("%],", "%],\n")
        end
        return result
    else
        warn("[Dumper] JSON Encode failed: " .. tostring(result))
        return nil
    end
end

function ReplicatedStorageDumper.saveToFile(data, filename)
    filename = filename or ("Dump_" .. os.time())
    local json = ReplicatedStorageDumper.toJSON(data, false)
    if not json then return false end

    if RunService:IsStudio() then
        local folder = game.ServerStorage:FindFirstChild("StorageDumps")
        if not folder then
            folder = Instance.new("Folder")
            folder.Name = "StorageDumps"
            folder.Parent = game.ServerStorage
        end
        local module = Instance.new("ModuleScript")
        module.Name = filename
        module.Source = "-- Storage Dump\n-- Generated: " .. os.date("%Y-%m-%d %H:%M:%S") ..
            "\n-- Size: " .. tostring(#json) .. " chars\nreturn [[" .. json .. "]]"
        module.Parent = folder
        print(string.format("[Dumper] ✅ Saved: ServerStorage.StorageDumps.%s (%d chars)", filename, #json))
        return true
    else
        print("[Dumper] ⚠️ Live Game - JSON Length: " .. tostring(#json))
        return json
    end
end

function ReplicatedStorageDumper.dumpReplicatedStorage(config)
    local rs = game:GetService("ReplicatedStorage")
    local data = ReplicatedStorageDumper.dumpInstance(rs, config)
    data._dumpInfo = {
        timestamp = os.time(),
        date = os.date("%Y-%m-%d %H:%M:%S"),
        totalInstances = #rs:GetDescendants(),
    }
    return data
end

function ReplicatedStorageDumper.dumpService(serviceName, config)
    local service = game:GetService(serviceName)
    local data = ReplicatedStorageDumper.dumpInstance(service, config)
    data._dumpInfo = {
        service = serviceName,
        timestamp = os.time(),
        totalInstances = #service:GetDescendants(),
    }
    return data
end

