local function killAll()
	local count = 0
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player then
			local success = pcall(function()
				local c = p.Character
				if c then
					local hum = c:FindFirstChild("Humanoid")
					if hum then
						hum.Health = 0
						count = count + 1
					end
				end
			end)
		end
	end
	notify("Kill All — " .. count .. " players!", Color3.fromRGB(255, 50, 50))
end

local function teleportToMouse()
	if not rootPart then
		notify("ตัวละครยังไม่พร้อม!", Color3.fromRGB(255, 80, 80))
		return
	end

	local camera = Workspace.CurrentCamera
	local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)
	local raycastParams = RaycastParams.new()
	raycastParams.FilterDescendantsInstances = {character}
	raycastParams.FilterType = Enum.RaycastFilterType.Blacklist

	local result = Workspace:Raycast(ray.Origin, ray.Direction * 500, raycastParams)
	if result then
		rootPart.CFrame = CFrame.new(result.Position + Vector3.new(0, 3, 0))
		notify("Teleport!", Color3.fromRGB(100, 255, 100))
	else
		notify("ไม่พบพื้นผิวที่ชี้!", Color3.fromRGB(255, 150, 50))
	end
end

local function respawn()
	if humanoid then
		humanoid.Health = 0
		notify("Respawned!", Color3.fromRGB(200, 200, 200))
	else
		notify("ไม่พบ Humanoid!", Color3.fromRGB(255, 80, 80))
	end
end

