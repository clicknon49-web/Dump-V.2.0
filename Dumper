-- █████████████████████████████████████████████████████████████
-- ███  REMOTE HOOK  ███
-- █████████████████████████████████████████████████████████████
local Hook = {
    Hooks          = {},   -- {[name/path] = { onCall, onReturn, block }}
    BlockedRemotes = {},   -- {[name/path] = true}
}
Dumper.RemoteHook = Hook

function Hook:HookRemote(name, opts)
    self.Hooks[name] = opts
    if opts.block then self.BlockedRemotes[name] = true end
    print(string.format("[Hook] 🪝 %s | onCall:%s onReturn:%s block:%s",
        name,
        opts.onCall and "✅" or "❌",
        opts.onReturn and "✅" or "❌",
        opts.block and "🚫" or "✅"))
end

function Hook:Unhook(name)
    self.Hooks[name] = nil
    self.BlockedRemotes[name] = nil
    print("[Hook] ❌ " .. name)
end

function Hook:Block(name)    self.BlockedRemotes[name] = true;  print("[Hook] 🚫 Block: " .. name) end
function Hook:Unblock(name)  self.BlockedRemotes[name] = nil;   print("[Hook] ✅ Unblock: " .. name) end

function Hook:ToggleBlock(name)
    if self.BlockedRemotes[name] then self:Unblock(name) else self:Block(name) end
end

function Hook:BlockAll()
    local remotes = Dumper.RemoteDump:FindAllRemotes()
    for _, r in ipairs(remotes) do self.BlockedRemotes[r.Name] = true end
    print(string.format("[Hook] 🚫 Block All: %d remotes", #remotes))
end

function Hook:UnblockAll()
    self.BlockedRemotes = {}
    print("[Hook] ✅ Unblock All")
end

function Hook:ListHooks()
    local r = {}
    for name, h in pairs(self.Hooks) do
        r[#r + 1] = { remote = name, hasOnCall = h.onCall ~= nil, hasOnReturn = h.onReturn ~= nil, blocked = self.BlockedRemotes[name] == true }
    end
    return r
end

function Hook:ListBlocked()
    local r = {}
    for name, b in pairs(self.BlockedRemotes) do
        if b then r[#r + 1] = name end
    end
    table.sort(r)
    return r
end

