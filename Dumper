-- ============================================
--  DUPE SYSTEM (Fixed)
-- ============================================
local dupeParts = {}
local dupeConn = nil

local function getTool()
	if not character then return nil end
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Tool") then return child end
	end
	return nil
end

local function startDupe()
	local tool = getTool()
	if not tool then
		notify("ไม่มี Tool! จับ pickaxe ก่อน", Color3.fromRGB(255, 80, 80))
		return false
	end

	if dupeConn then dupeConn:Disconnect() end

	dupeConn = tool.Activated:Connect(function()
		if not CONFIG.DupeEnabled then return end
		if not rootPart then return end

		local origin = rootPart.CFrame
		local count = 0

		for i = 1, CONFIG.DupeCount do
			if not CONFIG.DupeEnabled then break end
			if not character then break end

			local success, dupe = pcall(function()
				return character:Clone()
			end)

			if success and dupe then
				dupe.Name = player.Name .. "_Dupe_" .. i

				-- Remove unnecessary scripts from clone
				for _, desc in ipairs(dupe:GetDescendants()) do
					if desc:IsA("Script") or desc:IsA("LocalScript") then
						desc:Destroy()
					end
				end

				dupe.Parent = Workspace

				local hrp = dupe:FindFirstChild("HumanoidRootPart")
				if hrp then
					hrp.CFrame = origin * CFrame.new(
						math.random(-3, 3),
						math.random(0, 2),
						math.random(-3, 3)
					)
				end

				local h = dupe:FindFirstChild("Humanoid")
				if h then
					h.WalkSpeed = 0
					h.JumpPower = 0
					h.PlatformStand = true
				end

				table.insert(dupeParts, dupe)
				count = count + 1
			end

			task.wait(CONFIG.DupeSpeed)
		end

		notify("สร้าง Dupe: " .. count .. " ตัว", Color3.fromRGB(0, 255, 200))
	end)

	notify("Dupe Mode: ON — กด Tool เพื่อสร้าง!", Color3.fromRGB(0, 255, 150))
	return true
end

local function clearDupes()
	if dupeConn then
		dupeConn:Disconnect()
		dupeConn = nil
	end
	for _, d in ipairs(dupeParts) do
		if d and d.Parent then
			pcall(function() d:Destroy() end)
		end
	end
	dupeParts = {}
	notify("ล้าง Dupe ทั้งหมด", Color3.fromRGB(255, 100, 100))
end

