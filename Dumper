local Spy = {
    Enabled    = false,
    Logs       = {},
    MaxLogs    = 5000,
    FilterMode = "Blacklist",
    Filters    = {},
    WatchList  = {},
    OnCall     = nil,
    _hooked    = false,
    _original  = nil,
    _inCall    = false,   -- re-entrancy guard
}
Dumper.RemoteSpy = Spy

-- --- Filter ---
function Spy:AddFilter(name)      self.Filters[name] = true end
function Spy:RemoveFilter(name)    self.Filters[name] = nil end
function Spy:ClearFilters()        self.Filters = {} end

function Spy:SetFilterMode(mode)
    assert(mode == "Blacklist" or mode == "Whitelist", "Mode must be Blacklist or Whitelist")
    self.FilterMode = mode
end

function Spy:_shouldLog(remote)
    local name = remote.Name
    local ok, path = pcall(function() return remote:GetFullName() end)
    path = ok and path or name
    if self.FilterMode == "Whitelist" then
        return self.Filters[name] == true or self.Filters[path] == true
    else
        return self.Filters[name] ~= true and self.Filters[path] ~= true
    end
end

-- --- Watch ---
function Spy:Watch(name)    self.WatchList[name] = true end
function Spy:Unwatch(name)  self.WatchList[name] = nil end

-- --- Arg Serialization ---
local function serializeArgs(args, maxLen)
    maxLen = maxLen or 300
    local out = {}
    for i, arg in ipairs(args) do
        local ok, val = pcall(serializeValue, arg)
        out[i] = ok and val or { _type = "error", value = tostring(arg) }
    end
    -- สรุปสนาย string แบบสน
    local ok, preview = pcall(function()
        local j = HttpService:JSONEncode(out)
        return #j > maxLen and j:sub(1, maxLen) .. "..." or j
    end)
    return out, ok and preview or "..."
end

-- --- Log ---
function Spy:Log(remote, method, args, direction)
    if not self:_shouldLog(remote) then return end

    local ok, path = pcall(function() return remote:GetFullName() end)
    local sArgs, preview = serializeArgs(args)

    local entry = {
        id        = #self.Logs + 1,
        timestamp = os.clock(),
        time      = os.date("%H:%M:%S"),
        remote    = remote.Name,
        path      = ok and path or remote.Name,
        className = remote.ClassName,
        method    = method,
        direction = direction,
        argsCount = #args,
        args      = sArgs,
        preview   = preview,
    }

    table.insert(self.Logs, entry)
    if #self.Logs > self.MaxLogs then
        table.remove(self.Logs, 1)
    end

    -- Real-time watch
    if self.WatchList[remote.Name] then
        print(string.format("🔍 [Spy] %s → %s (%s) | Args[%d]: %s",
            entry.time, remote.Name, direction, #args, preview))
    end

    -- Drawing UI update
    if Dumper._uiEnabled and Dumper._updateUI then
        pcall(Dumper._updateUI, entry)
    end

    -- Callback
    if self.OnCall then
        pcall(self.OnCall, entry)
    end

    return entry
end

-- --- Search / Stats ---
function Spy:ClearLogs()   self.Logs = {} end

function Spy:SearchLogs(query)
    query = query:lower()
    local r = {}
    for _, e in ipairs(self.Logs) do
        if e.remote:lower():find(query, 1, true) or e.path:lower():find(query, 1, true) then
            r[#r + 1] = e
        end
    end
    return r
end

function Spy:SearchByArg(query)
    query = tostring(query):lower()
    local r = {}
    for _, e in ipairs(self.Logs) do
        if e.preview:lower():find(query, 1, true) then
            r[#r + 1] = e
        end
    end
    return r
end

function Spy:GetStats()
    local stats = {
        totalCalls  = #self.Logs,
        byRemote    = {},
        byMethod    = {},
        byDirection = {},
        byClass     = {},
    }
    for _, e in ipairs(self.Logs) do
        stats.byRemote[e.remote]    = (stats.byRemote[e.remote] or 0) + 1
        stats.byMethod[e.method]    = (stats.byMethod[e.method] or 0) + 1
        stats.byDirection[e.direction] = (stats.byDirection[e.direction] or 0) + 1
        stats.byClass[e.className]  = (stats.byClass[e.className] or 0) + 1
    end
    return stats
end

function Spy:GetTopRemotes(n)
    n = n or 10
    local s = self:GetStats()
    local sorted = {}
    for name, count in pairs(s.byRemote) do
        sorted[#sorted + 1] = { name = name, count = count }
    end
    table.sort(sorted, function(a, b) return a.count > b.count end)
    local out = {}
    for i = 1, math.min(n, #sorted) do out[i] = sorted[i] end
    return out
end

function Spy:ExportLogs()
    return Dumper.toJSON({
        exportTime = os.date("%Y-%m-%d %H:%M:%S"),
        executor   = executorName .. " " .. executorVersion,
        totalLogs  = #self.Logs,
        logs       = self.Logs,
    }, true)
end

function Spy:SaveLogs()
    local json = self:ExportLogs()
    if json then
        return Dumper.saveToFile({ logs = self.Logs }, "SpyLogs_" .. os.time())
    end
end

-- --- Start / Stop ---
function Spy:Start()
    if not hasHookAPI then
        warn("[RemoteSpy] ❌ ต้องใช้ Executor ที่มี hookmetamethod + getnamecallmethod")
        warn("[RemoteSpy]   ปัจจุบัน: " .. executorName .. " " .. executorVersion)
        return false
    end
    if self._hooked then
        self.Enabled = true
        print("[RemoteSpy] ✅ Re-enabled")
        return true
    end

    self.Enabled = true
    self._hooked = true

    -- hookmetamethod __namecall พรอม re-entrancy guard
    self._original = _hookmetamethod(game, "__namecall", _newcclosure(function(self, ...)
        -- Re-entrancy guard: ปองกัน infinite recursion
        if Spy._inCall then
            return Spy._original(self, ...)
        end

        local method = _getnamecallmethod()
        local ref = safeRef(self)

        local remoteType = nil
        local direction  = nil

        -- ตรวจ Remote ดวย pcall เพื่อความปลอดภัย
        local isRE, isRF, isURE
        pcall(function()
            isRE  = ref:IsA("RemoteEvent")
            isRF  = ref:IsA("RemoteFunction")
            isURE = ref:IsA("UnreliableRemoteEvent")
        end)

        if method == "FireServer" then
            if isRE then   remoteType = "RemoteEvent";           direction = "Client→Server"
            elseif isURE then remoteType = "UnreliableRemoteEvent"; direction = "Client→Server"
            end
        elseif method == "InvokeServer" and isRF then
            remoteType = "RemoteFunction"; direction = "Client→Server"
        elseif method == "FireClient" and isRE then
            remoteType = "RemoteEvent"; direction = "Server→Client"
        elseif method == "FireAllClients" and isRE then
            remoteType = "RemoteEvent"; direction = "Server→AllClients"
        elseif method == "InvokeClient" and isRF then
            remoteType = "RemoteFunction"; direction = "Server→Client"
        end

        if direction and Spy.Enabled then
            Spy._inCall = true

            local args = { ... }
            local Hook = Dumper.RemoteHook
            local remoteName = ref.Name
            local remotePath
            pcall(function() remotePath = ref:GetFullName() end)

            -- Hook data
            local hookData = Hook.Hooks[remoteName] or Hook.Hooks[remotePath]

            -- Block check
            if Hook.BlockedRemotes[remoteName] or Hook.BlockedRemotes[remotePath] then
                Spy:Log(ref, method, args, direction .. " [BLOCKED]")
                Spy._inCall = false
                if remoteType == "RemoteFunction" then return nil end
                return
            end

            -- onCall hook (modify args)
            if hookData and hookData.onCall then
                local ok, modArgs = pcall(hookData.onCall, ref, method, args)
                if ok and modArgs ~= nil then
                    args = modArgs
                end
            end

            -- Log
            Spy:Log(ref, method, args, direction)

            -- Call original
            if remoteType == "RemoteFunction" then
                local returnVals = { Spy._original(ref, unpack(args)) }
                Spy._inCall = false

                -- onReturn hook
                if hookData and hookData.onReturn then
                    local ok, modRet = pcall(hookData.onReturn, ref, method, unpack(returnVals))
                    if ok and modRet ~= nil then
                        return modRet
                    end
                end
                return unpack(returnVals)
            else
                local result = Spy._original(ref, unpack(args))
                Spy._inCall = false
                return result
            end
        end

        return Spy._original(self, ...)
    end))

    print(string.format("[RemoteSpy] ✅ เริ่มดักฟัง (%s %s)", executorName, executorVersion))
    return true
end

function Spy:Stop()
    self.Enabled = false
    print("[RemoteSpy] ⏹️ หยุดดักฟัง")
end

