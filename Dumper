local Dump = {
    DefaultServices = {
        "ReplicatedStorage",
        "Workspace",
        "StarterGui",
        "StarterPack",
        "StarterPlayerScripts",
        "StarterCharacterScripts",
        "Lighting",
    },
    _watchConns = {},
}
Dumper.RemoteDump = Dump

local REMOTE_CLASSES = { "RemoteEvent", "RemoteFunction", "UnreliableRemoteEvent" }

local function isRemote(inst)
    for _, cn in ipairs(REMOTE_CLASSES) do
        local ok, yes = pcall(function() return inst:IsA(cn) end)
        if ok and yes then return true end
    end
    return false
end

function Dump:FindRemotesInService(serviceName)
    local ok, svc = pcall(function() return game:GetService(serviceName) end)
    if not ok then return {} end
    local remotes = {}
    for _, inst in ipairs(svc:GetDescendants()) do
        if isRemote(inst) then remotes[#remotes + 1] = inst end
    end
    return remotes
end

function Dump:FindAllRemotes(services)
    services = services or self.DefaultServices
    local all = {}
    for _, sn in ipairs(services) do
        local r = self:FindRemotesInService(sn)
        for _, v in ipairs(r) do all[#all + 1] = v end
    end
    return all
end

-- ★ Delta: สแกน nil instances (remotes ที่ถูก parent ไว้ใน nil)
function Dump:FindNilRemotes()
    if not hasNilInst then
        warn("[Dump] getnilinstances ไม่พร้อมใช้งาน")
        return {}
    end
    local ok, nilInsts = pcall(_getnilinstances)
    if not ok then return {} end

    local remotes = {}
    for _, inst in ipairs(nilInsts) do
        if isRemote(inst) then
            remotes[#remotes + 1] = inst
        end
    end
    print(string.format("[Dump] 🔍 nil instances: พบ %d remotes", #remotes))
    return remotes
end

-- ★ Delta: สแกน GC หา remotes ที่ซอนอยู่ (ยงไม่ถูก GC)
function Dump:FindGCRemotes()
    if not hasGetGC then
        warn("[Dump] getgc ไม่พร้อมใช้งาน")
        return {}
    end
    local ok, gcTable = pcall(_getgc)
    if not ok then return {} end

    local found = {}
    local seen = {}
    for _, obj in ipairs(gcTable) do
        if type(obj) == "userdata" then
            local isInst, isR = pcall(function() return isRemote(obj) end)
            if isInst and isR then
                local name = obj.Name
                local path
                pcall(function() path = obj:GetFullName() end)
                local key = path or name
                if not seen[key] then
                    seen[key] = true
                    found[#found + 1] = obj
                end
            end
        end
    end
    print(string.format("[Dump] 🔍 GC scan: พบ %d unique remotes", #found))
    return found
end

-- ★ Deep Scan: รวมทุกแหล่ง
function Dump:DeepScan(services)
    services = services or self.DefaultServices
    local all = {}

    local seen = {}

    local function addRemote(r)
        local ok, path = pcall(function() return r:GetFullName() end)
        local key = ok and path or r.Name
        if not seen[key] then
            seen[key] = true
            all[#all + 1] = r
        end
    end

    -- 1. Services
    for _, sn in ipairs(services) do
        for _, r in ipairs(self:FindRemotesInService(sn)) do addRemote(r) end
    end

    -- 2. Nil instances
    for _, r in ipairs(self:FindNilRemotes()) do addRemote(r) end

    -- 3. GC
    for _, r in ipairs(self:FindGCRemotes()) do addRemote(r) end

    print(string.format("[Dump] 🎯 DeepScan: พบทั้งหมด %d unique remotes", #all))
    return all
end

function Dump:DumpAll(services, config)
    services = services or self.DefaultServices
    config = config or Dumper.Config

    local report = {
        timestamp = os.time(),
        date = os.date("%Y-%m-%d %H:%M:%S"),
        executor = executorName .. " " .. executorVersion,
        services = {},
        summary = {
            totalRemotes = 0,
            remoteEvents = 0,
            remoteFunctions = 0,
            unreliableRemoteEvents = 0,
        },
        remotes = {},
    }

    for _, sn in ipairs(services) do
        local remotes = self:FindRemotesInService(sn)
        local svcData = { name = sn, count = #remotes, remotes = {} }

        for _, remote in ipairs(remotes) do
            local ok, path = pcall(function() return remote:GetFullName() end)
            local rd = {
                name      = remote.Name,
                className = remote.ClassName,
                path      = ok and path or remote.Name,
                parent    = remote.Parent and remote.Parent.Name or "?",
            }

            if config.SaveAttributes then
                local attrs = remote:GetAttributes()
                if next(attrs) then rd.attributes = attrs end
            end

            local children = remote:GetChildren()
            if #children > 0 then
                rd.children = {}
                for _, ch in ipairs(children) do
                    rd.children[#rd.children + 1] = { name = ch.Name, className = ch.ClassName }
                end
            end

            svcData.remotes[#svcData.remotes + 1] = rd
            report.remotes[#report.remotes + 1] = rd

            report.summary.totalRemotes = report.summary.totalRemotes + 1
            local cn = remote.ClassName
            if cn == "RemoteEvent" then report.summary.remoteEvents = report.summary.remoteEvents + 1
            elseif cn == "RemoteFunction" then report.summary.remoteFunctions = report.summary.remoteFunctions + 1
            elseif cn == "UnreliableRemoteEvent" then report.summary.unreliableRemoteEvents = report.summary.unreliableRemoteEvents + 1
            end
        end

        report.services[#report.services + 1] = svcData
    end

    table.sort(report.remotes, function(a, b) return a.name:lower() < b.name:lower() end)
    return report
end

function Dump:DumpAllJSON(services, config)
    return Dumper.toJSON(self:DumpAll(services, config), true)
end

function Dump:SaveDump(services, config)
    local report = self:DumpAll(services, config)
    return Dumper.saveToFile(report, "RemoteDump_" .. os.time())
end

-- --- Group by Parent ---
function Dump:GroupByParent(services)
    local remotes = self:FindAllRemotes(services)
    local groups = {}
    for _, remote in ipairs(remotes) do
        local parent = remote.Parent
        local key = parent and parent:GetFullName() or "Unknown"
        if not groups[key] then
            groups[key] = { parentName = parent and parent.Name or "?", parentPath = key, remotes = {} }
        end
        groups[key].remotes[#groups[key].remotes + 1] = { name = remote.Name, className = remote.ClassName }
    end
    return groups
end

-- --- Tree View ---
function Dump:PrintTree(services)
    local remotes = self:FindAllRemotes(services)
    local tree = {}

    for _, remote in ipairs(remotes) do
        local ok, path = pcall(function() return remote:GetFullName() end)
        local fullPath = ok and path or remote.Name
        local parts = fullPath:split(".")
        local current = tree

        for i, part in ipairs(parts) do
            if i == #parts then
                local icon = remote:IsA("RemoteEvent") and "📡"
                    or remote:IsA("RemoteFunction") and "📞"
                    or "📶"
                current[#current + 1] = { type = "remote", icon = icon, name = part, className = remote.ClassName }
            else
                local found = nil
                for _, node in ipairs(current) do
                    if node.type == "folder" and node.name == part then found = node; break end
                end
                if not found then
                    found = { type = "folder", name = part, children = {} }
                    current[#current + 1] = found
                end
                current = found.children
            end
        end
    end

    local function printNode(node, indent)
        indent = indent or ""
        if node.type == "folder" then
            print(indent .. "📁 " .. node.name .. "/")
            for _, child in ipairs(node.children) do printNode(child, indent .. "  ") end
        else
            print(indent .. node.icon .. " " .. node.name .. "  [" .. node.className .. "]")
        end
    end

    print("\n╔══════════════ REMOTE TREE ══════════════╗")
    for _, node in ipairs(tree) do printNode(node) end
    print("╚═════════════════════════════════════════╝\n")
end

-- --- Watch for New Remotes ---
function Dump:WatchForNewRemotes(callback, services)
    services = services or self.DefaultServices
    for _, conn in ipairs(self._watchConns) do pcall(function() conn:Disconnect() end) end
    self._watchConns = {}

    for _, sn in ipairs(services) do
        local ok, svc = pcall(function() return game:GetService(sn) end)
        if ok then
            local conn = svc.DescendantAdded:Connect(function(desc)
                if isRemote(desc) then
                    local info = {
                        name = desc.Name, className = desc.ClassName,
                        path = desc:GetFullName(), service = sn,
                        timestamp = os.clock(), time = os.date("%H:%M:%S"),
                    }
                    print(string.format("[Dump] 🆕 New: %s (%s) → %s", desc.Name, desc.ClassName, info.path))
                    if callback then pcall(callback, info) end
                end
            end)
            self._watchConns[#self._watchConns + 1] = conn
        end
    end

    -- nil instances watcher (polling เนื่องจากไม่มี event)
    if hasNilInst then
        local knownNil = {}
        spawn(function()
            while #self._watchConns > 0 do
                local ok, nilInsts = pcall(_getnilinstances)
                if ok then
                    for _, inst in ipairs(nilInsts) do
                        if isRemote(inst) then
                            local key = inst.Name .. ":" .. (pcall(function() return inst:GetFullName() end) or "?")
                            if not knownNil[key] then
                                knownNil[key] = true
                                print(string.format("[Dump] 🆕 New (nil): %s (%s)", inst.Name, inst.ClassName))
                                if callback then
                                    pcall(callback, {
                                        name = inst.Name, className = inst.ClassName,
                                        path = "nil", service = "nil",
                                        timestamp = os.clock(), time = os.date("%H:%M:%S"),
                                    })
                                end
                            end
                        end
                    end
                end
                task.wait(1)
            end
        end)
    end

    print(string.format("[Dump] 👀 Watching %d services (+ nil poll)", #services))
end

function Dump:StopWatching()
    for _, conn in ipairs(self._watchConns) do pcall(function() conn:Disconnect() end) end
    self._watchConns = {}
    print("[Dump] ⏹️ Stopped watching")
end

