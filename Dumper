-- ============================================
--  DUPE LOGIC
-- ============================================
local dupeConnections = {}
local dupeParts = {}
local isDupeActive = false

local function getTool()
    return character:FindFirstChildOfClass("Tool")
end

local function startDupe()
    if isDupeActive then return end
    isDupeActive = true

    local tool = getTool()
    if not tool then
        warn("[BluezyGPT] ไม่มี Tool ในมือ!")
        return
    end

    -- Hook Activate
    local conn = tool.Activated:Connect(function()
        if not isDupeActive then return end

        local dupeCount = 0
        local originalPos = rootPart.CFrame

        for i = 1, CONFIG.MaxDupes do
            if not isDupeActive then break end

            -- Clone character
            local dupe = character:Clone()
            dupe.Name = "Dupe_" .. i
            dupe.Parent = workspace

            -- Position offset
            local offset = CFrame.new(
                math.random(-3, 3),
                math.random(0, 2),
                math.random(-3, 3)
            )
            dupe:WaitForChild("HumanoidRootPart").CFrame = originalPos * offset

            -- Remove unnecessary
            for _, child in ipairs(dupe:GetChildren()) do
                if child:IsA("Humanoid") then
                    child.WalkSpeed = 0
                    child.JumpPower = 0
                end
            end

            table.insert(dupeParts, dupe)
            dupeCount = dupeCount + 1

            task.wait(CONFIG.DupeSpeed)
        end

        print("[BluezyGPT] สร้าง Dupe จำนวน: " .. dupeCount)
    end)

    table.insert(dupeConnections, conn)
    print("[BluezyGPT] Dupe Mode: ON")
end

local function stopDupe()
    isDupeActive = false

    -- Disconnect
    for _, conn in ipairs(dupeConnections) do
        conn:Disconnect()
    end
    dupeConnections = {}

    -- Remove dupes
    for _, dupe in ipairs(dupeParts) do
        if dupe and dupe.Parent then
            dupe:Destroy()
        end
    end
    dupeParts = {}

    print("[BluezyGPT] Dupe Mode: OFF — ล้าง Dupe ทั้งหมด")
end

-- ============================================
--  Agnes 2.5 Flash COLLECT
-- ============================================
local Agnes 2.5 FlashCollectConn = nil
local function startAgnes 2.5 FlashCollect()
    if Agnes 2.5 FlashCollectConn then Agnes 2.5 FlashCollectConn:Disconnect() end

    Agnes 2.5 FlashCollectConn = workspace.ChildAdded:Connect(function(child)
        if not CONFIG.Agnes 2.5 FlashCollect then return end
        -- ตรวจสอบว่าเป็นของ collect ได้
        if child:FindFirstChild("Collectible") or child:FindFirstChild("Pickup") or
           child:FindFirstChild("Ore") or child:FindFirstChild("Coin") or
           child:FindFirstChild("Gem") then
            local root = child:FindFirstChildWhichIsA("BasePart")
            if root then
                local dist = (root.Position - rootPart.Position).Magnitude
                if dist < 30 then
                    root.CFrame = rootPart.CFrame * CFrame.new(0, 1, 0)
                end
            end
        end
    end)
end

-- ============================================
--  NOCLIP
-- ============================================
local noclipConn = nil
local function setNoclip(enabled)
    if noclipConn then noclipConn:Disconnect() end
    if not enabled then
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
        return
    end
    noclipConn = player.CharacterAdded:Connect(function(char)
        for _, part in ipairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end)
    -- Apply immediately
    for _, part in ipairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end
end

-- ============================================
--  ESP
-- ============================================
local espConnections = {}
local function updateESP()
    if not CONFIG.ESP then
        for _, conn in ipairs(espConnections) do
            conn:Disconnect()
        end
        espConnections = {}
        -- Remove existing ESP
        for _, obj in ipairs(workspace:GetDescendants()) do
            if obj.Name == "BluezyESP" then obj:Destroy() end
        end
        return
    end

    for _, obj in ipairs(workspace:GetChildren()) do
        if obj:IsA("Model") and obj ~= character then
            local hrp = obj:FindFirstChild("HumanoidRootPart")
            local hum = obj:FindFirstChild("Humanoid")
            if hrp and hum and hum.Health > 0 then
                -- Check if already has ESP
                if not obj:FindFirstChild("BluezyESP") then
                    local box = Instance.new("SelectionBox")
                    box.Name = "BluezyESP"
                    box.LineThickness = CONFIG.ESPThickness
                    box.Color = CONFIG.ESPColor
                    box.Adornee = hrp
                    box.Parent = hrp
                end
            end
        end
    end
end

